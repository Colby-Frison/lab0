# Objective B — Simple Queue Simulator (outline)
# Driven by remaining work, with an optional safety limit.
# One complete pass per clock: serve -> move -> fill -> admit -> fill -> record.
# Design: src/design/obj-b/README.md

# --- State ---
clock = 0
systems = load_config()              # list of QueueSystems (Obj B: one; Obj E: many)
# Each QS: streaming source (one-row lookahead), waiting queue, servers[],
#          service_plan, persistent sink writer,
#          edges in/out, current_transfers, next_transfers
# Global: shared event log, shared qmet writer
# Transfer: { job, from_qsid, to_qsid, available_time }

# Work remains while any source has jobs, any waiting queue nonempty,
# any server is busy, or any current/next transfer buffer is nonempty.
# MAIN LOOP: exactly one pass per clock value.
while work_remaining(systems) and not safety_limit_reached(clock):
  reset errors_this_step for every Qs

  # 1. SERVE jobs that entered service before this clock.
  for each Qs in systems:
    for each busy server S in Qs:
      decrement S.rate_timer by 1
      if S.rate_timer == 0:
        apply next function in S.service_plan
        log TASK-END / TASK-START when the front task changes
        update S.chain_index / repeat policy
        set S.visit_complete when the service plan is finished
        reset S.rate_timer when more service is required

  # 2. MOVE all service-visit-complete jobs.
  for each Qs in systems:
    for each server S where S.visit_complete:
      J = S.job
      log EXITS-SERVER
      if J.Tasks == [] and Qs has sink:
        write sink wl (J.id, arrival=clock, Tasks=[])
        log DEPART-VIA sink
      else if Qs has edges_out:
        edge = deterministic_weighted_pick(Qs.edges_out)
        stage Transfer(J, Qs.id, edge.target, available_time=clock+1)
        log DEPART-VIA edge
      else:
        drop J
        log ERROR NO-OUT-EDGE
        Qs.errors_this_step++
      clear S

  # 3. FILL from jobs already waiting (FCFS / work-conserving).
  for each Qs in systems:
    fill_idle_servers_from_waiting(Qs)

  # 4. ADMIT all source/transfer arrivals due now.
  for each Qs in systems:
    while Qs.source has job J with J.arrival == clock:
      J = Qs.source.pop()
      J.queue_arrival_time = clock
      log ARRIVE-VIA source
      if Qs has idle server:
        start J immediately             # ENTERS-SERVER, TASK-START
      else if Qs.waiting is not full:
        Qs.waiting.push_back(J)
      else:
        drop J
        log ERROR QUEUE-FULL
        Qs.errors_this_step++

    while Qs.current_transfers.front.available_time == clock:
      transfer = Qs.current_transfers.pop_front()
      J = transfer.job
      J.queue_arrival_time = clock
      log ARRIVE-VIA transfer.from_qsid
      if Qs has idle server:
        start J immediately             # ENTERS-SERVER, TASK-START
      else if Qs.waiting is not full:
        Qs.waiting.push_back(J)
      else:
        drop J
        log ERROR QUEUE-FULL
        Qs.errors_this_step++

  # 5. FILL again as an invariant check (normally handled during admission).
  for each Qs in systems:
    fill_idle_servers_from_waiting(Qs)

  # 6. RECORD dense metrics and advance exactly once.
  for each Qs in systems:
    write qmet(clock, Qs.id, |waiting|, |in_service|, errors_this_step)

  commit next_transfers as next clock's current_transfers
  clock++

# --- I/O / logging (all queues) ---
# inputs:  per-QS source .wl (config Source column); edge buffers between QS
# outputs: per-QS sink .wl (config Sink column)
# logging: one event log for all QS; one qmet.csv with a row per (clock, QS)
# safe optimization: jump over a fully idle gap only, while still emitting the
# required zero-state qmet rows for each skipped time.
