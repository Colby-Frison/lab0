# Post-process qmet.csv into per-queue USE windows.
# Not part of the simulator loop. Each queue is its own series.

function normalize_qid(token):
    # "q0" / "007" -> "0" so the config matches qmet.csv
    return decimal digits at the end of token

function load_server_counts(qconf):
    # Sys ID -> Num. Servers. Later commas inside [edges] do not affect these fields.
    for row in qconf:
        counts[normalize_qid(row.sys_id)] = row.num_servers
    return counts

function window_stats(values, end, size, how):
    # Only the steps that exist: start = max(0, end - size + 1)
    window = values[start : end + 1]
    if how == mean: return sum(window) / length(window)
    return sum(window)

function compute_use(qmet, server_counts):
    columns = time-step, queue-sys-id,
              Utilization(10), Saturation(10), Errors(10),
              Utilization(100), Saturation(100), Errors(100),
              Utilization(1000), Saturation(1000), Errors(1000)
    rows = []
    for qid, series in group qmet by queue-sys-id, time order:
        if qid not in server_counts: error
        servers = server_counts[qid]
        busy = [in_service / servers for each step]
        waiting = [num-jobs-in-queue for each step]
        drops = [num-of-errors for each step]
        for i, step in enumerate(series):
            row = {time-step: step.time, queue-sys-id: qid}
            for size in [10, 100, 1000]:
                row[Utilization(size)] = window_stats(busy, i, size, mean)
                row[Saturation(size)] = window_stats(waiting, i, size, mean)
                row[Errors(size)] = window_stats(drops, i, size, sum)
            rows.append(row)
    sort rows by time-step, then queue id
    write quse.csv
